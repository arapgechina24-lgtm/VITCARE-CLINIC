<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily backup of BOTH Supabase projects.

    cp deploy/com.vitcare.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.vitcare.backup.plist

  Runs at 02:15. Late enough that the pharmacy is closed, early enough that a
  failure is visible before opening.

  StartCalendarInterval, not StartInterval: launchd runs a missed calendar job
  once the Mac WAKES, so a machine that slept overnight still gets its backup.

  RunAtLoad is here because that only holds for sleep, not for shutdown. A
  gui/ agent is not loaded at all while the Mac is off, so a 02:15 event on a
  powered-down machine is not deferred — it is lost, silently, with nothing in
  either log. That is not theoretical: on 2026-08-11 this job reported
  `runs = 0` and `last exit code = (never exited)` while the newest snapshot
  was 64 hours old. The schedule had never fired once. Only `npm run health`
  noticed, because it checks backup AGE rather than whether the job is loaded.

  RunAtLoad makes login the second trigger, so any day the Mac is used gets a
  backup. The cost is one extra run per login — a few KB — and it doubles as
  the Supabase keep-awake heartbeat described below.

  IT ALSO KEEPS THE PROJECTS AWAKE. Supabase free-tier projects pause after 7
  days without a request, and any API call resets that timer. This already bit
  the pharmacy on 2026-08-01. A daily backup is both the backup and the
  heartbeat.

  Failures land in vitcare-backup.error.log and the script exits non-zero. If
  a table cannot be read it is recorded as an error in the manifest rather
  than written as an empty file — a backup that silently captures nothing is
  the failure mode worth engineering against.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vitcare.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>export PATH="$HOME/.nvm/versions/node/v24.16.0/bin:$PATH"; cd /Users/arapg/vitcare-clinic &amp;&amp; node scripts/backup.mjs &amp;&amp; node scripts/backup.mjs --verify</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <!-- Second trigger: see the note at the top. Without this, a Mac that is
         powered off at 02:15 silently skips the backup entirely. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/arapg/Library/Logs/vitcare-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arapg/Library/Logs/vitcare-backup.error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/arapg/vitcare-clinic</string>
</dict>
</plist>
