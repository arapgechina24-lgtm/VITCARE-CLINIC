<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily backup of BOTH Supabase projects.

    cp deploy/com.vitcare.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.vitcare.backup.plist

  Runs every 30 minutes, and again at login.

  It used to run once daily at 02:15. That was changed on 2026-08-12: the
  pharmacy now trades against the cloud all day, so a single overnight
  snapshot meant a failure at closing time destroyed a full day of sales,
  stock movements and dispensed prescriptions. See the StartInterval note.

  The earlier design leaned on StartCalendarInterval because launchd runs a
  missed calendar job once the Mac WAKES, so a machine that slept overnight
  still got its backup. That holds for sleep but NOT for shutdown: a gui/
  agent is not loaded at all while the Mac is off, so a 02:15 event on a
  powered-down machine was not deferred — it was lost, silently, with nothing
  in either log. On 2026-08-11 this job reported `runs = 0` and `last exit
  code = (never exited)` while the newest snapshot was 64 hours old. The
  schedule had never fired once. Only `npm run health` noticed, because it
  checks backup AGE rather than whether the job is loaded — keep it that way.

  IT ALSO KEEPS THE PROJECTS AWAKE. Supabase free-tier projects pause after 7
  days without a request, and any API call resets that timer. This already bit
  the pharmacy on 2026-08-01. A daily backup is both the backup and the
  heartbeat.

  Failures land in vitcare-backup.error.log and the script exits non-zero. If
  a table cannot be read it is recorded as an error in the manifest rather
  than written as an empty file — a backup that silently captures nothing is
  the failure mode worth engineering against.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vitcare.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>export PATH="$HOME/.nvm/versions/node/v24.16.0/bin:$PATH"; cd /Users/arapg/vitcare-clinic &amp;&amp; node scripts/backup.mjs &amp;&amp; node scripts/backup.mjs --verify</string>
    </array>

    <!-- Every 30 minutes, replacing the single 02:15 calendar run.
         A once-a-day backup means a disk failure at 6pm costs a whole
         trading day: every sale, every stock movement, every prescription
         dispensed since 02:15. At 30 minutes the worst case is half an hour.

         The cost is nil. A full snapshot of BOTH projects gzips to ~136 KB,
         so 48 runs a day is ~6.5 MB of egress and, at the retention below,
         ~136 MB on disk. StartInterval also coalesces: a Mac asleep for six
         hours runs this ONCE on wake, not twelve times.

         StartCalendarInterval is gone — a 30-minute interval subsumes a
         daily 02:15 event, and two triggers doing the same job is two things
         to keep in step. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Still needed. StartInterval only counts while the agent is LOADED,
         and a gui/ agent is not loaded while the Mac is off — so a machine
         shut down overnight resumes its interval at login rather than
         catching up. RunAtLoad guarantees the first backup of the day
         happens the moment someone signs in.

         It also doubles as the Supabase keep-awake heartbeat: free-tier
         projects pause after 7 days idle, which took the pharmacy down on
         2026-08-01. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- ~21 days of half-hourly history. Retention is counted in SNAPSHOTS,
         not days, so it has to move whenever the frequency does: leaving it
         at the default 30 would have silently cut history from 30 days to
         15 HOURS the moment the interval above changed. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>VITCARE_BACKUP_KEEP</key>
        <string>1000</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/arapg/Library/Logs/vitcare-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arapg/Library/Logs/vitcare-backup.error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/arapg/vitcare-clinic</string>
</dict>
</plist>
