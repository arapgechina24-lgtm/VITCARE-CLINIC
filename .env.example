# ── Supabase (this project's own, separate from vitcare-pos) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # the sb_publishable_… key, NOT the legacy anon JWT.
                                # Legacy keys can be disabled per-project and sign-in
                                # stops dead the moment they are; it is baked into the
                                # client bundle, so changing it needs a REBUILD.
SUPABASE_SERVICE_ROLE_KEY=      # sb_secret_… — server only. Install with
                                # scripts/set-service-key.mjs, which verifies the key
                                # belongs to this project before writing it.

# ── VITCARE-POS integration (Prescription Integration contract) ──
POS_BASE_URL=                # e.g. https://<vitcare-pos-host>/api
POS_SIGNING_SECRET=          # 32+ random bytes; same value configured on the POS side
POS_REQUEST_TIMEOUT_MS=8000
OUTBOX_DRAIN_SECRET=         # random string, sent as `Authorization: Bearer <secret>` to
                             # POST /api/prescriptions/outbox-drain. NOT a query token —
                             # query strings land in access logs. See integration/drain-auth.ts.
